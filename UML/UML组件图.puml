@startuml
skinparam defaultFontName "Noto Sans CJK SC"
left to right direction
skinparam componentStyle rectangle
skinparam componentFontSize 15
skinparam shadowing false

package "表现层" {
  [参与者端页面]
  [组织者端页面]
  [检票端页面]
  [管理端页面]
}

package "应用服务层" {
  [活动服务]
  [审核服务]
  [报名服务]
  [检票服务]
  [统计与导出服务]
  [通知服务]
}

package "领域层" {
  [活动与场次模型]
  [报名与候补模型]
  [签到与审计模型]
  [业务策略]
}

package "基础设施层" {
  database "关系数据库" as DB
  [事务管理器]
  [服务器时钟]
  [CSV 导出器]
  [通知渠道]
}

[参与者端页面] --> [活动服务] : 查询活动
[参与者端页面] --> [报名服务] : 报名/取消/候补
[组织者端页面] --> [活动服务] : 维护活动
[组织者端页面] --> [统计与导出服务] : 名单/统计
[检票端页面] --> [检票服务] : 核验凭证
[管理端页面] --> [审核服务] : 审核活动
[管理端页面] --> [统计与导出服务] : 平台汇总

[活动服务] --> [活动与场次模型]
[活动服务] --> [业务策略]
[审核服务] --> [活动与场次模型]
[审核服务] --> [签到与审计模型]
[报名服务] --> [报名与候补模型]
[报名服务] --> [业务策略]
[报名服务] --> [事务管理器]
[报名服务] --> [通知服务]
[检票服务] --> [签到与审计模型]
[检票服务] --> [报名与候补模型]
[检票服务] --> [事务管理器]
[统计与导出服务] --> [报名与候补模型]
[统计与导出服务] --> [签到与审计模型]
[统计与导出服务] --> [CSV 导出器]
[通知服务] --> [通知渠道]

[活动与场次模型] --> DB
[报名与候补模型] --> DB
[签到与审计模型] --> DB
[事务管理器] --> DB
[报名服务] ..> [服务器时钟] : 截止判定
[检票服务] ..> [服务器时钟] : 签到时间

note right of [报名服务]
  报名、取消、递补、检票写入
  在事务管理器中执行，并在提交前
  复查活动状态（REQ-006/028）。
end note
@enduml
